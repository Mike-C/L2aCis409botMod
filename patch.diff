+	/**
+	 * Picks a random NO-Grade Item ID from the cached pool.
+	 * @return a valid item ID, or 0 if something went wrong or cache is empty.
+	 */
+	public static int getRndNGradeItemId()
+	{
+		if (NO_GRADE_ITEM_IDS.isEmpty())
+		{
+			return 0; // Fallback or safety boundary check
+		}
+		
+		// Use the native aCis core Rnd manager to fetch a random index
+		return NO_GRADE_ITEM_IDS.get(Rnd.get(NO_GRADE_ITEM_IDS.size()));
+	}
+	
