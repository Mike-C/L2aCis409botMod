+	private void moveCircle(Player fakePlayer, int locX, int locY, int LocZ, int cir1, int cir2)
+	{
+		Random rndX = new Random(), rndY = new Random();
+		boolean c1, c2;
+		do
+		{
+			// fakePlayer.teleportTo(45350, 49530, -3064, rs.getInt("heading"));
+			fakePlayer.getPosition().set(locX, /* 49530 */locY, LocZ, 0);
+			int newX = locX, newY = locY, counter = 0;
+			do
+			{
+				if (counter++ > 5)
+				{
+					newX = locX;
+					newY = locY;
+					counter = 0;
+				}
+				newX += rndX.nextInt(cir1 << 1) - cir1;
+				newY += rndY.nextInt(cir1 << 1) - cir1;
+				c1 = fakePlayer.isIn2DRadius(new Location(newX, newY, LocZ), cir1);
+				c2 = fakePlayer.isIn2DRadius(new Location(newX, newY, LocZ), cir2);
+			}
+			while (!c1 || c2);
+			// fakePlayer.teleportTo(newX, newY, -3064, rs.getInt("heading"));
+			
+			int absoluteZ = GeoEngine.getInstance().getHeight(newX, newY, LocZ);
+			fakePlayer.getPosition().set(newX, newY, absoluteZ, rnd.nextInt(65536));
+		}
+		while (findAllNearbyObjects(fakePlayer, 50));
+	}
