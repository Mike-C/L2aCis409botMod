+public final class BotClanData implements IXmlReader
+{
+	private final List<BotClan> _botClans = new ArrayList<>();
+	
+	protected BotClanData()
+	{
+		load();
+	}
+	
+	@Override
+	public void load()
+	{
+		parseFile("./data/xml/botClans.xml");
+		LOGGER.info("Loaded {} Bot Clans.", _botClans.size());
+	}
+	
+	@Override
+	public void parseDocument(Document doc, Path path)
+	{
+		forEach(doc, "list", listNode ->
+		{
+			forEach(listNode, "clan", clanNode -> _botClans.add(new BotClan(parseAttributes(clanNode))));
+		});
+	}
+	
+	public List<BotClan> getBotClans()
+	{
+		return _botClans;
+	}
+	
+	public static BotClanData getInstance()
+	{
+		return SingletonHolder.INSTANCE;
+	}
+	
+	private static class SingletonHolder
+	{
+		protected static final BotClanData INSTANCE = new BotClanData();
+	}
+}
