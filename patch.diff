+	{
+		parseFile("./data/xml/botClans.xml");
+		LOGGER.info("Loaded {} Bot Clans.", _botClans.size());
+	}
+	
+	@Override
+	public void parseDocument(Document doc, Path path)
+	{
+		forEach(doc, "list", listNode ->
