+	@Override
+	public void run()
+	{
+		// 1. Safety Check: If the bot disconnected, died, or logged out, stop the AI loop
+		if (_bot == null || !_bot.isOnline() || _bot.isDead())
+			return;
+		
+		// hp potions
+		double currentHpPercent = _bot.getStatus().getHpRatio(); // Returns a value between 0.0 and 1.0
+		
+		if (currentHpPercent <= 0.50) // Trigger when HP drops below 50%
+		{
+			// Check if the bot isn't already under a healing potion cooldown or effect
+			// Standard Greater HP Potion Item ID in Lineage 2 is 1539
+			int potionItemId = 1539;
+			
+			// Find the item instance inside the bot's inventory container
+			ItemInstance potion = _bot.getInventory().getItemByItemId(potionItemId);
+			
+			if (potion != null)
+			{
+				// Native aCis 409 call to simulate a player right-clicking / using an item
+				// _bot.getInventory().useEquipItem(potion, false);
+				
+				final IItemHandler handler = ItemHandler.getInstance().getHandler(potion.getEtcItem());
+				if (handler != null)
+					handler.useItem(_bot, potion, false);
+			}
+		}
+		
+		ItemInstance closestDrop = findNearbyItem(/* SEARCH_RADIUS */_bot.isMageClass() ? 750 : 150);
+		if (closestDrop != null && !(_bot.getAI().getCurrentIntention().getType() == IntentionType.ATTACK))
+		{
+			_bot.setTarget(closestDrop);
+			
+			if (MathUtil.checkIfInRange(50, _bot, closestDrop, true))
+			{
+				// Stop moving and tell aCis AI to pick up the item
+				_bot.getAI().tryToIdle();
+				_bot.getAI().tryToPickUp(closestDrop.getObjectId(), false);
+				_bot.setTarget(null); // Clear target so it re-evaluates next cycle
+				
+				// Pause briefly for the pickup animation to complete
+				ThreadPool.schedule(this, 1200);
+			}
+			else
+			{
+				// Move directly to the dropped item
+				_bot.getMove().maybeMoveToLocation(closestDrop.getPosition(), 0, true, false);
+				
+				// Run the loop faster while traveling to check distance frequently
+				ThreadPool.schedule(this, 500);
+			}
+			return; // Break early so the bot doesn't look for monsters while looting
+		}
+		
+		// 2. Target Acquisition: Find a nearby monster if we don't have one
+		if (_bot.getTarget() == null || !(_bot.getTarget() instanceof Attackable) || ((Attackable) _bot.getTarget()).isDead())
+		{
+			useNextTargetManhattan(_bot);
+			
+			Attackable target = (Attackable) _bot.getTarget();
+			if (_bot.getTarget() == null)
+			{
+				target = findNearbyMonster(1500); // Look in a 1500-radius circle
+			}
+			if (target != null)
+			{
+				_bot.setTarget(target);
+				if (_bot.isMageClass())
+				{
+					Attackable monster = (Attackable) _bot.getTarget();
+					// tryChargeShots(_bot);
+					do
+					{
+						useSkill(_bot, monster, 1177); // Wind Strike
+						useSkill(_bot, monster, 1184); // Ice Bolt
+						
+						try
+						{
+							// Pause execution for 200 milliseconds (0.2 seconds)
+							Thread.sleep(200);
+						}
+						catch (InterruptedException e)
+						{
+							// Handle the exception if the thread is interrupted while sleeping
+							Thread.currentThread().interrupt();
+						}
+					}
+					while (!monster.isDead());
+				}
+			}
+			else
+			{
+				// No monsters found, make the bot move randomly to "explore"
+				moveRandomly(450);
+				ThreadPool.schedule(this, 4000); // Re-run AI check in 4 seconds
+				return;
+			}
+		}
+		
+		// 3. Combat Logic
+		Attackable monster = (Attackable) _bot.getTarget();
+		
+		// Is the bot close enough to attack?
+		if (!_bot.isMageClass())
+		{
+			if (MathUtil.checkIfInRange(100, _bot, monster, true)) // 100 range for fighters
+			{
+				tryChargeShots(_bot);
+				
+				useSkill(_bot, monster, 3); // Power Strike
+				
+				_bot.getAI().tryToAttack(monster);
+			}
+			else
+			{
+				// Move toward the monster
+				// _bot.getMove().maybeMoveToPawn(monster, 0, false);
+				_bot.getMove().maybeMoveToLocation(monster.getPosition(), 0, true, false);
+			}
+		}
+		
+		// 4. Loop execution: Repeat the AI logic every 1.5 seconds during combat
+		ThreadPool.schedule(this, 1500);
+	}
+	
+	/**
+	 * Finds the closest valid visible item on the ground.
+	 * @param radius
+	 * @return
+	 */
+	public ItemInstance findNearbyItem(int radius)
+	{
+		// Iterate through all items currently known/visible to the bot
+		for (ItemInstance item : _bot.getKnownType(ItemInstance.class))
+		{
+			// Skip items that are null, invisible, or already being decayed/looted
+			if (item == null || !item.isVisible())
+				continue;
+				
+			// Uses internal short-circuit logic (no square root calculations)
+			// Parameters: (int range, WorldObject obj1, WorldObject obj2, boolean includeZ)
+			if (MathUtil.checkIfInRange(radius, _bot, item, true))
+			{
+				return item; // Returns the first valid item found within the box/radius
+			}
+		}
+		
+		return null; // Return null if no items are within the specified radius
+	}
+	
+	private Attackable findNearbyMonster(int radius)
+	{
+		// Fetch all objects inside the player's visibility range
+		List<Attackable> monsters = _bot.getKnownTypeInRadius(Attackable.class, radius);
+		for (Attackable monster : monsters)
+		{
+			if (!monster.isDead() && monster.isAttackableWithoutForceBy(_bot))
+			{
+				return monster;
+			}
+		}
+		return null;
+	}
+	
+	private void moveRandomly(int offset)
+	{
+		int newX = _bot.getX() + (net.sf.l2j.commons.random.Rnd.get(offset * 2) - offset);
+		int newY = _bot.getY() + (net.sf.l2j.commons.random.Rnd.get(offset * 2) - offset);
+		_bot.getMove().maybeMoveToLocation(new Location(newX, newY, _bot.getZ()), 0, true, false);
+	}
+	
+	public void tryChargeShots(Player bot)
+	{
+		// 1. Ensure the bot actually has a weapon equipped
+		ItemInstance weaponInstance = bot.getActiveWeaponInstance();
+		if (weaponInstance == null)
+			return;
+		
+		// 2. Determine which shot type to use based on the weapon's properties
+		ShotType shotType = ShotType.SOULSHOT; // Default
+		int shotId = 0;
+		
+		Weapon weapon = (Weapon) (weaponInstance.getItem());
+		// aCis 409 uses weapon item templates to check magical vs physical
+		// characteristics
+		if (bot.isMageClass())
+		{
+			// Check if weapon is mage-oriented, assign Blessed Spiritshot (or regular)
+			shotType = ShotType.SPIRITSHOT;
+			shotId = getSpiritshotIdForGrade(weaponInstance.getItem().getCrystalType());
+		}
+		else
+		{
+			shotType = ShotType.SOULSHOT;
+			shotId = getSoulshotIdForGrade(weaponInstance.getItem().getCrystalType());
+		}
+		
+		// 3. Check if the shot is already charged to prevent wasting items
+		if (bot.isChargedShot(shotType))
+			return;
+		
+		// 4. Look for the item in the bot's inventory
+		ItemInstance shotItem = bot.getInventory().getItemByItemId(shotId);
+		if (shotItem != null && bot.getInventory().destroyItem(shotItem, 1) != null)
+		{
+			// 5. Charge the shot on the bot's weapon
+			bot.setChargedShot(shotType, true);
+			
+			// 6. Broadcast the visual shot charging effect animation to surrounding players
+			bot.broadcastPacket(new MagicSkillUse(bot, bot, shotType == ShotType.SOULSHOT ? 2039 : 2047, 1, 0, 0));
+		}
+	}
+	
+	private static int getSoulshotIdForGrade(CrystalType grade)
+	{
+		return switch (grade)
+		{
+			// case NONE -> 1835; // Soulshot: No Grade
+			case NONE -> 5789; // Soulshot: No Grade For Beginners
+			case D -> 1463; // Soulshot: D-Grade
+			case C -> 1464; // Soulshot: C-Grade
+			case B -> 1465; // Soulshot: B-Grade
+			case A -> 1466; // Soulshot: A-Grade
+			case S -> 1467; // Soulshot: S-Grade
+		};
+	}
+	
+	private static int getSpiritshotIdForGrade(CrystalType grade)
+	{
+		return switch (grade)
+		{
+			// case NONE -> 3947; // Blessed Spiritshot: No Grade
+			case NONE -> 5790; // Spiritshot: No grade for beginners
+			case D -> 3948; // Blessed Spiritshot: D-Grade
+			case C -> 3949; // Blessed Spiritshot: C-Grade
+			case B -> 3950; // Blessed Spiritshot: B-Grade
+			case A -> 3951; // Blessed Spiritshot: A-Grade
+			case S -> 3952; // Blessed Spiritshot: S-Grade
+		};
+	}
+	
+	/**
+	 * Next target selection using fast coordinate delta arithmetic.
+	 * @param bot
+	 */
+	public void useNextTargetManhattan(Player bot)
+	{
+		final int nextTargetRadius = 350;
+		List<Attackable> nearbyMonsters = bot.getKnownTypeInRadius(Attackable.class, nextTargetRadius);
+		
+		Attackable closestMonster = null;
+		int closestManhattanDistance = Integer.MAX_VALUE;
+		
+		for (Attackable monster : nearbyMonsters)
+		{
+			if (monster == null || monster.isDead() || !monster.isVisible() || !monster.isAttackableWithoutForceBy(bot))
+			{
+				continue;
+			}
+			
+			// Pure coordinate delta subtraction (No squaring, No getDistance calls)
+			int deltaX = Math.abs(bot.getX() - monster.getX());
+			int deltaY = Math.abs(bot.getY() - monster.getY());
+			int currentManhattanDistance = deltaX + deltaY;
+			
+			if (currentManhattanDistance < closestManhattanDistance)
+			{
+				closestManhattanDistance = currentManhattanDistance;
+				closestMonster = monster;
+			}
+		}
+		
+		if (closestMonster != null)
+		{
+			bot.setTarget(closestMonster);
+		}
+	}
