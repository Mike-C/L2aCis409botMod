+	public static void loadItemsUpToGrade()
+	{
+		NO_GRADE_ITEM_IDS.clear();
+		D_GRADE_ITEM_IDS.clear();
+		C_GRADE_ITEM_IDS.clear();
+		
+		// Loop through every item template registered in the aCis core XML engine
+		for (Item template : ItemData.getInstance().getTemplates())
+		{
+			if (template == null)
+				continue;
+			
+			switch (template.getCrystalType())
+			{
+				case CrystalType.NONE:
+					// Optional: Filter out quest items, adena, or arrows if desired
+					if (template.isQuestItem())
+						continue;
+					
+					// Check if the item template is an EtcItem, then retrieve its type
+					if (template.getItemType() == EtcItemType.SEED || template.getItemType() == EtcItemType.SEED2)
+					{
+						// Skip seeds from the fake bot shop
+						continue;
+					}
+					
+					int tIId = template.getItemId();
+					NO_GRADE_ITEM_IDS.add(tIId);
+					if (DESIRED_ITEMS[tIId])
+					{
+						int j = 6;
+						if (tIId == 730 || tIId == 948 || tIId == 952 || tIId == 956 || tIId == 960)
+							j = 7; // enchants more probable
+						for (int i = 0; i < 1 << j; i++)
+							NO_GRADE_ITEM_IDS.add(tIId);
+					}
+					break;
+				case CrystalType.D:
+					D_GRADE_ITEM_IDS.add(template.getItemId());
+					break;
+				case CrystalType.C:
+					C_GRADE_ITEM_IDS.add(template.getItemId());
+					break;
+			}
+		}
+		LOGGER.info("ItemsGradePicker: Cached " + NO_GRADE_ITEM_IDS.size() + " No-Grade items.");
+		LOGGER.info("ItemsGradePicker: Cached " + D_GRADE_ITEM_IDS.size() + " D-Grade items.");
+		LOGGER.info("ItemsGradePicker: Cached " + C_GRADE_ITEM_IDS.size() + " C-Grade items.");
+	}
