@@ -0,0 +1,108 @@
+package net.sf.l2j.gameserver.data.manager; // Place in an appropriate manager folder
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import net.sf.l2j.commons.logging.CLogger;
+
+import net.sf.l2j.commons.random.Rnd;
+import net.sf.l2j.gameserver.model.World;
+
+public class FakeNameManager
+{
+	private static final CLogger LOGGER = new CLogger(FakeNameManager.class.getName());
+    
+    private final List<String> _availableNames = new ArrayList<>();
+    
+    // Tracks names currently in use on the server to prevent duplicates
+    private final Set<String> _usedNames = ConcurrentHashMap.newKeySet();
+
+    protected FakeNameManager()
+    {
+        load();
+    }
+
+    public void load()
+    {
+        _availableNames.clear();
+        _usedNames.clear();
+
+        File file = new File("./data/fake_names.txt");
+        if (!file.exists())
+        {
+        	LOGGER.warn("FakeNameManager: Target file data/fake_names.txt missing!");
+            return;
+        }
+
+        try (BufferedReader br = new BufferedReader(new FileReader(file, StandardCharsets.UTF_8)))
+        {
+            String line;
+            while ((line = br.readLine()) != null)
+            {
+                line = line.trim();
+                // Skip empty lines, comments, or strings violating client max name length (16 characters)
+                if (line.isEmpty() || line.startsWith("#") || line.length() > 16)
+                    continue;
+
+                _availableNames.add(line);
+            }
+        }
+        catch (Exception e)
+        {
+        	LOGGER.warn("FakeNameManager: Error reading fake player name configurations: " + e.getMessage());
+        }
+
+        // Shuffle the list immediately to avoid sequential patterns
+        Collections.shuffle(_availableNames);
+        LOGGER.info("FakeNameManager: Loaded " + _availableNames.size() + " unique bot names.");
+    }
+
+    /**
+     * Retrieves a clean, unique random name that isn't currently active in the game world.
+     */
+    public String requestUniqueName()
+    {
+        if (_availableNames.isEmpty())
+            return "Bot_" + Rnd.get(1000, 9999); // Safe hardcoded fallback
+
+        // Attempt up to 20 times to find an unused name from the pool
+        for (int i = 0; i < 20; i++)
+        {
+            String name = _availableNames.get(Rnd.get(_availableNames.size()));
+            
+            // Core safety checks: Not already assigned to a bot, and not active on a real player
+            if (!_usedNames.contains(name) && World.getInstance().getPlayer(name) == null)
+            {
+                _usedNames.add(name);
+                return name;
+            }
+        }
+
+        // Final fallback if pool is fully exhausted or experiencing heavy collisions
+        return "Trader_" + Rnd.get(10000, 99999);
+    }
+
+    /**
+     * Always free up the name when your fake bot logs out or gets deleted!
+     */
+    public void releaseName(String name)
+    {
+        _usedNames.remove(name);
+    }
+
+    public static FakeNameManager getInstance()
+    {
+        return SingletonHolder.INSTANCE;
+    }
+
+    private static class SingletonHolder
+    {
+        protected static final FakeNameManager INSTANCE = new FakeNameManager();
+    }
+}
