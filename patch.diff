@@ -0,0 +1,81 @@
+package net.sf.l2j.gameserver.data.manager;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.util.concurrent.atomic.LongAdder;
+import net.sf.l2j.commons.logging.CLogger;
+import net.sf.l2j.commons.pool.ThreadPool;
+import net.sf.l2j.commons.pool.ConnectionPool;
+
+public class ServerMetricsManager
+{
+	private static final CLogger LOGGER = new CLogger(FakeTraderManager.class.getName());
+	
+	private static final String TOTAL_ADENA_DROP_PER_SERVER = "totalAdenaDrop"; // name of the column in server_memo table
+	
+	private static final LongAdder _totalAdenaDropped = new LongAdder();
+	
+	private ServerMetricsManager()
+	{
+		// Load the initial value from the DB on server startup
+		loadFromDatabase();
+		
+		// Start an elegant background task to save metrics every 2 minutes asynchronously
+		ThreadPool.scheduleAtFixedRate(this::saveToDatabase, 120000, 120000);
+	}
+	
+	public static void trackAdena(long amount)
+	{
+		_totalAdenaDropped.add(amount);
+	}
+	
+	public static long getTotalAdenaDropped()
+	{
+		return _totalAdenaDropped.sum();
+	}
+	
+	private void loadFromDatabase()
+	{
+		try (Connection con = ConnectionPool.getConnection();
+			PreparedStatement ps = con.prepareStatement("SELECT value FROM server_memo WHERE var = ?"))
+		{
+			ps.setString(1, TOTAL_ADENA_DROP_PER_SERVER);
+			var rs = ps.executeQuery();
+			if (rs.next())
+			{
+				_totalAdenaDropped.add(rs.getLong("value"));
+			}
+		}
+		catch (Exception e)
+		{
+			LOGGER.warn("ServerMetricsManager: Could not load adena drop metrics: " + e.getMessage());
+		}
+	}
+	
+	public void saveToDatabase()
+	{
+		try (Connection con = ConnectionPool.getConnection();
+			PreparedStatement ps = con.prepareStatement("INSERT INTO server_memo (var, value) VALUES (?, ?) ON DUPLICATE KEY UPDATE value = ?"))
+		{
+			long currentTotal = getTotalAdenaDropped();
+			ps.setString(1, TOTAL_ADENA_DROP_PER_SERVER);
+			ps.setLong(2, currentTotal);
+			ps.setLong(3, currentTotal);
+			ps.executeUpdate();
+		}
+		catch (Exception e)
+		{
+			LOGGER.error("ServerMetricsManager: Failed to save adena drop metrics to DB: " + e.getMessage());
+		}
+	}
+	
+	public static ServerMetricsManager getInstance()
+	{
+		return SingletonHolder._instance;
+	}
+	
+	private static class SingletonHolder
+	{
+		protected static final ServerMetricsManager _instance = new ServerMetricsManager();
+	}
+}
